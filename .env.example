PORT=3000
# Optional server-side GitHub token for higher API rate limits. Public repositories work without it.
GITHUB_TOKEN=
# Set a BharatCode developer API key locally or in the Render service environment. Leave blank to use rule-based analysis.
BHARATCODE_API_KEY=
# Optional OpenAI-compatible HTTPS endpoint override; defaults to BharatCode's API.
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
# Required with BHARATCODE_API_KEY. Choose a model currently available to your BharatCode account.
BHARATCODE_MODEL=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:4175,http://127.0.0.1:4175
