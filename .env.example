PORT=3000
# Optional server-side GitHub token for higher API rate limits. Public repositories work without it.
GITHUB_TOKEN=
# Configure all three AI values to enable the optional provider; rule-based analysis works without them.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:4175,http://127.0.0.1:4175
