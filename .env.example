PORT=3000
# Optional server-side GitHub token for higher API rate limits. Public repositories work without it.
GITHUB_TOKEN=
# Optional. Select nvidia-nim, bharatcode, or openai-compatible; blank enables automatic selection.
AI_PROVIDER=
# NVIDIA NIM uses its OpenAI-compatible Chat Completions API.
# Keep the actual key in a local ignored .env file or the deployment secret settings.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Example NVIDIA model ID; availability depends on the provider account and endpoint.
NVIDIA_NIM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# Generic OpenAI-compatible provider. Configure all three values to enable it.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Legacy BharatCode variables remain supported. Set AI_PROVIDER=bharatcode to select explicitly.
# BHARATCODE_API_KEY=
# BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
# BHARATCODE_MODEL=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:4175,http://127.0.0.1:4175
